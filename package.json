    "phase2": "node \"Фаза 2 - Распределение работы/Расчёты/phase2.mjs\"",
    "phase4": "node \"Фаза 4 - Прогнозирование/Расчёты/monte-carlo.mjs\"",
    "phase5": "node \"Фаза 5 - Планирование/Расчёты/schedule.mjs\"",
    "report": "node report.mjs",
    "test": "node --test \"Фаза 1 - Выбор концепции проекта/Расчёты/test/*.test.mjs\" \"Фаза 2 - Распределение работы/Расчёты/*.test.mjs\""
